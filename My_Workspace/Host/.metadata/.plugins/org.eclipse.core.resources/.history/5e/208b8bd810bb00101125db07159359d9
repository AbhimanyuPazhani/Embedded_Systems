#include<stdio.h>

void wait_for_input (void);
int main(void)

{
	float Radius;
	float PI = 3.14159265;
	float Area;

	printf("Enter the Radius of the Circle:");
	fflush(stdout);

	scanf("%f", &Radius);


	Area = (PI * (Radius * Radius));
	printf("\nThe Area of the Circle is : %.2f", Area);
	wait_for_input ();
	return 0;

}

void wait_for_input (void)
{
	printf("\nPress enter to EXIT");
	while (getchar()!= '\n');
	getchar();
}
